/**
 * Generates src/server/database/database.types.ts from the live catalog, in the shape
 * supabase-js expects (Database → public → Tables/Views/Functions). Written in-repo because the
 * Supabase CLI type generator needs Docker or an account-wide access token.
 */
import type postgres from "postgres";

const SCALARS: Record<string, string> = {
  uuid: "string", text: "string", varchar: "string", bpchar: "string", date: "string", timestamptz: "string",
  timestamp: "string", time: "string", int2: "number", int4: "number", int8: "number", numeric: "number",
  float4: "number", float8: "number", bool: "boolean", json: "Json", jsonb: "Json", void: "undefined",
  geometry: "unknown", geography: "unknown",
};

function tsType(udt: string): string {
  if (udt.startsWith("_")) return `${tsType(udt.slice(1))}[]`;
  return SCALARS[udt] ?? "unknown";
}

type Column = { table_name: string; column_name: string; udt_name: string; is_nullable: boolean; has_default: boolean; insertable: boolean };
type Fk = { name: string; table_name: string; columns: string[]; ref_table: string; ref_columns: string[]; one_to_one: boolean };
type Fn = { name: string; arg_names: string[] | null; arg_types: string[]; arg_defaults: number; returns: string; returns_set: boolean };

export async function generateTypes(sql: postgres.Sql, migrationVersion: string): Promise<string> {
  const columns = await sql<Column[]>`
    select c.relname as table_name, a.attname as column_name, t.typname as udt_name,
           not a.attnotnull as is_nullable,
           (a.atthasdef or a.attidentity <> '') as has_default,
           true as insertable
    from pg_attribute a
    join pg_class c on c.oid = a.attrelid
    join pg_namespace n on n.oid = c.relnamespace
    join pg_type t on t.oid = a.atttypid
    where n.nspname = 'public' and c.relkind = 'r' and a.attnum > 0 and not a.attisdropped
    order by c.relname, a.attnum`;
  const fks = await sql<Fk[]>`
    select con.conname as name, cl.relname as table_name,
           array(select a.attname from unnest(con.conkey) with ordinality k(n, i) join pg_attribute a on a.attrelid = con.conrelid and a.attnum = k.n order by k.i) as columns,
           rcl.relname as ref_table,
           array(select a.attname from unnest(con.confkey) with ordinality k(n, i) join pg_attribute a on a.attrelid = con.confrelid and a.attnum = k.n order by k.i) as ref_columns,
           exists (select 1 from pg_constraint u where u.conrelid = con.conrelid and u.contype in ('p', 'u') and u.conkey::int[] @> con.conkey::int[] and u.conkey::int[] <@ con.conkey::int[]) as one_to_one
    from pg_constraint con
    join pg_class cl on cl.oid = con.conrelid
    join pg_namespace n on n.oid = cl.relnamespace
    join pg_class rcl on rcl.oid = con.confrelid
    join pg_namespace rn on rn.oid = rcl.relnamespace
    where con.contype = 'f' and n.nspname = 'public' and rn.nspname = 'public'
    order by cl.relname, con.conname`;
  const fns = await sql<Fn[]>`
    select p.proname as name, p.proargnames as arg_names,
           array(select format_type(x, null) from unnest(p.proargtypes) x) as arg_types_fmt,
           array(select t.typname from unnest(p.proargtypes) with ordinality x(oid, i) join pg_type t on t.oid = x.oid order by x.i) as arg_types,
           p.pronargdefaults as arg_defaults,
           rt.typname as returns, p.proretset as returns_set
    from pg_proc p
    join pg_namespace n on n.oid = p.pronamespace
    join pg_type rt on rt.oid = p.prorettype
    where n.nspname = 'public' and p.prokind = 'f'
      and not exists (select 1 from pg_depend d where d.objid = p.oid and d.deptype = 'e')
    order by p.proname`;

  const tables = [...new Set(columns.map((c) => c.table_name))];
  const q = (s: string) => JSON.stringify(s);
  const lines: string[] = [];
  lines.push(
    "// GENERATED by `pnpm db:types` from the live development schema. Do not edit by hand.",
    `// Schema version: migration ${migrationVersion}. PostGIS geometry columns are typed unknown; read them via RPC/GeoJSON.`,
    "",
    "export type Json = string | number | boolean | null | { [key: string]: Json | undefined } | Json[];",
    "",
    "export type Database = {",
    "  public: {",
    "    Tables: {",
  );
  for (const t of tables) {
    const cols = columns.filter((c) => c.table_name === t);
    const row = cols.map((c) => `          ${c.column_name}: ${tsType(c.udt_name)}${c.is_nullable ? " | null" : ""};`);
    const ins = cols.map((c) => `          ${c.column_name}${c.is_nullable || c.has_default ? "?" : ""}: ${tsType(c.udt_name)}${c.is_nullable ? " | null" : ""};`);
    const upd = cols.map((c) => `          ${c.column_name}?: ${tsType(c.udt_name)}${c.is_nullable ? " | null" : ""};`);
    const rels = fks.filter((f) => f.table_name === t).map((f) =>
      `          { foreignKeyName: ${q(f.name)}; columns: ${JSON.stringify(f.columns)}; isOneToOne: ${f.one_to_one}; referencedRelation: ${q(f.ref_table)}; referencedColumns: ${JSON.stringify(f.ref_columns)} },`);
    lines.push(
      `      ${t}: {`,
      "        Row: {", ...row, "        };",
      "        Insert: {", ...ins, "        };",
      "        Update: {", ...upd, "        };",
      rels.length ? "        Relationships: [" : "        Relationships: [];",
      ...(rels.length ? [...rels, "        ];"] : []),
      "      };",
    );
  }
  lines.push("    };", "    Views: { [_ in never]: never };", "    Functions: {");
  for (const f of fns) {
    const names = f.arg_names ?? [];
    const required = f.arg_types.length - f.arg_defaults;
    const args = f.arg_types.map((t, i) => `${names[i] ?? `arg${i}`}${i >= required ? "?" : ""}: ${tsType(t)}`);
    const ret = tsType(f.returns) + (f.returns_set ? "[]" : "");
    lines.push(`      ${f.name}: { Args: ${args.length ? `{ ${args.join("; ")} }` : "Record<PropertyKey, never>"}; Returns: ${ret} };`);
  }
  lines.push(
    "    };",
    "    Enums: { [_ in never]: never };",
    "    CompositeTypes: { [_ in never]: never };",
    "  };",
    "};",
    "",
    'export type Tables<T extends keyof Database["public"]["Tables"]> = Database["public"]["Tables"][T]["Row"];',
    'export type TablesInsert<T extends keyof Database["public"]["Tables"]> = Database["public"]["Tables"][T]["Insert"];',
    'export type TablesUpdate<T extends keyof Database["public"]["Tables"]> = Database["public"]["Tables"][T]["Update"];',
    "",
  );
  return lines.join("\n");
}
