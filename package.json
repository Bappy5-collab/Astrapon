{
  "name": "astrapon",
  "version": "0.1.0",
  "private": true,
  "description": "Astrapon: field-scale crop rotation decision support with an interactive 3D farm simulator.",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/copy-maplibre-worker.mjs && next dev",
    "build": "node scripts/copy-maplibre-worker.mjs && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "verify:sources": "tsx scripts/verify-sources.mts",
    "test:db": "vitest run --config vitest.db.config.mts",
    "db:status": "tsx scripts/db/migrate.mts",
    "db:migrate": "tsx scripts/db/migrate.mts --apply",
    "db:import-reference": "tsx scripts/db/import-reference.mts",
    "db:types": "tsx scripts/db/verify.mts --write-types",
    "db:verify": "tsx scripts/db/verify.mts",
    "db:rehearse": "tsx scripts/db/rehearse.mts",
    "evidence:worker": "tsx scripts/evidence-worker.mts",
    "evidence:trace": "tsx scripts/evidence-trace.mts",
    "simulation:trace": "tsx scripts/simulation-trace.mts",
    "global:cases": "tsx scripts/global-cases.mts",
    "auth:config": "tsx scripts/supabase-auth-config.mts",
    "water:trace": "tsx scripts/water-trace.mts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@emotion/cache": "11.14.0",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/icons-material": "9.5.0",
    "@mui/material": "9.5.0",
    "@mui/material-nextjs": "9.5.0",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "maplibre-gl": "6.15.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "three": "0.186.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@emotion/server": "11.11.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.186.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "postgres": "3.4.7",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
