# Astrapon environment template.
# Copy to .env.local (git-ignored) and fill in values. Never commit real values.
# Every variable is optional: missing features show an honest "not configured"
# state on /setup instead of failing.

# --- Supabase (public; inlined into the browser bundle) -----------------------
# Use a NEW, dedicated Astrapon development project. Do not reuse another
# app's project. Dashboard -> Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public base URL used in account emails (confirmation, password reset).
# Production: https://astrapon.vercel.app . Leave empty locally (the request origin is used).
# The same URL must be listed in Supabase -> Authentication -> URL Configuration -> Redirect URLs.
NEXT_PUBLIC_SITE_URL=

# --- Supabase (server only; secret) ------------------------------------------
# Secret key (sb_secret_...). Used by server jobs and reference-data scripts only.
SUPABASE_SECRET_KEY=

# --- NASA Earthdata Login (server only; secret) ------------------------------
# User token from https://urs.earthdata.nasa.gov/ for archives that require login.
# Reserved for IMERG / SMAP (not used by the app yet). Keep server-side only.
NASA_EARTHDATA_TOKEN=

# --- OpenTopography Global DEM API (server only; secret) --------------------
# Free key from https://portal.opentopography.org/ (terms: keep it server-side).
# Reserved for NASADEM elevation (not used yet).
OPENTOPOGRAPHY_API_KEY=

# --- AI-assisted explanation drafting (server only; secret; optional) --------
# Optional: drafts plain-language explanations of a stored run (claude-opus-5-5). Without it,
# the app says AI drafting is not configured and everything else works.
ANTHROPIC_API_KEY=

# --- GitHub Actions worker trigger (server only; secret; optional) ---------
# Fine-grained token with "Actions: Read and write" on this repository only. When set, queueing
# evidence or a run starts .github/workflows/evidence-worker.yml at once instead of waiting for
# its 10-minute schedule. GITHUB_DISPATCH_REPO defaults to Bappy5-collab/Astrapon.
GITHUB_DISPATCH_TOKEN=
# GITHUB_DISPATCH_REPO=

# --- Supabase database connection (scripts only; secret) --------------------
# Session pooler URI from Supabase -> Connect, with your database password in place
# of [YOUR-PASSWORD] (URL-encode special characters). Used only by `pnpm db:*`
# scripts to inspect/apply migrations, import reference data, generate types and
# verify policies. The scripts refuse to run if its project ref differs from
# NEXT_PUBLIC_SUPABASE_URL. Also used by `pnpm evidence:worker`. Never used by the web app.
SUPABASE_DB_URL=

# --- Evidence pipeline and maps (optional, not secret) -----------------------
# Directory for the raw provider response cache (default .cache/evidence).
# ASTRAPON_CACHE_DIR=
# Set to 1 to switch off place search without a code change (Nominatim policy).
# GEOCODER_DISABLED=
# Replace the OpenStreetMap tile URL (e.g. a commercial or self-hosted tile server).
# NEXT_PUBLIC_OSM_TILE_URL=
# Test-only: comma-separated provider hosts to treat as unreachable (outage checks).
# ASTRAPON_SIMULATE_OUTAGE=

# Personal access token (supabase.com -> Account -> Access tokens), only for `pnpm auth:config`. Never commit it.
SUPABASE_ACCESS_TOKEN=
